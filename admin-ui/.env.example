SWEATBOX_API_BASE_URL=https://api.base.url
AUTH_COOKIE_NAME=sb_access_token
AUTH_COOKIE_MAX_AGE_SECONDS=604800

# Support channels shown on the Help & Support page.
# The email defaults to info@wixander.com in code; override it here to point at
# a different mailbox, or set it empty to hide the email action. The URL is
# optional and adds a Contact Support button when set.
NEXT_PUBLIC_SUPPORT_EMAIL=info@wixander.com
NEXT_PUBLIC_SUPPORT_URL=
