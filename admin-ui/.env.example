SWEATBOX_API_BASE_URL=https://api.base.url
AUTH_COOKIE_NAME=sb_access_token
AUTH_COOKIE_MAX_AGE_SECONDS=604800

# Optional. When set, the Help & Support page shows a Contact Support action.
# Leave unset and the page tells staff to contact their system administrator
# instead of pointing at a channel that does not exist.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_URL=
